// 이 파일은 "docusaurus start/build" 명령에서 사용하지 않습니다.
// 편집기의 타입 검사와 자동 완성을 지원하기 위한 설정이며,
// package.json의 "typecheck" 스크립트로 직접 검사할 때도 사용합니다.
{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "strict": true
  },
  "exclude": [".docusaurus", "build"]
}
