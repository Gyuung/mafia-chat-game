# 파일 제외 규칙은 https://help.github.com/articles/ignoring-files/ 문서를 참고하세요.

# 의존성
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 테스트 결과
/coverage

# Next.js 생성 파일
/.next/
/out/

# 배포 빌드 결과
/build

# 기타 파일
.DS_Store
*.pem

# 디버그 로그
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 환경 변수 파일은 기본적으로 제외하며 필요한 예제 파일만 커밋 허용
.env*
!.env.example
!docs-site/.env.example

# Vercel 로컬 설정
.vercel

# TypeScript 생성 파일
*.tsbuildinfo
next-env.d.ts

# 로컬 전용 문서
docs/GIT_UPLOAD.md
